{
  "id": "com.storyboarder.sequencetoboard",
  "name": "Storyboarder",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "storyboarderPanel",
      "label": { "default": "Storyboarder" },
      "minimumSize": { "width": 300, "height": 360 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 620 },
      "preferredFloatingSize": { "width": 420, "height": 680 }
    }
  ]
}
